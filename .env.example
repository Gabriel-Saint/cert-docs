# Banco de dados
# Local: host "localhost". No docker compose completo o host vira "postgres".
POSTGRES_USER=cpfpdf
POSTGRES_PASSWORD=cpfpdf
POSTGRES_DB=cpfpdf
DATABASE_URL=postgresql://cpfpdf:cpfpdf@localhost:5432/cpfpdf

# API (porta padrão 3000; não defina PORT aqui: o Nx carrega este .env em todas as tarefas,
# inclusive no dev server do Angular, que passaria a usar a mesma porta da API)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Certificados
# Endereço do frontend usado no QR Code e no link de verificação
PUBLIC_WEB_URL=http://localhost:4200
INSTITUTION_NAME=Academia Horizonte
INSTITUTION_CITY=São Paulo
INSTITUTION_DIRECTOR=Dra. Helena Duarte
INSTITUTION_DIRECTOR_ROLE=Diretora Acadêmica
# Pasta dos PDFs emitidos (no Docker: /data/certificates, em volume)
CERTIFICATES_STORAGE_DIR=storage/certificates

# Seed (usuário ADMIN inicial)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
ADMIN_CPF=52998224725
